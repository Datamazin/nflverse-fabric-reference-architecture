DEFINE
    VAR _Season =
        TREATAS (
            { ( "__SEASON__", "__SEASON_TYPE__" ) },
            'Player Season Summary'[season],
            'Player Season Summary'[season_type]
        )
EVALUATE
CALCULATETABLE (
    ROW ( "Yds", [Passing Yards], "TD", [Passing TDs], "Cmp Pct", [Completion Percentage], "EPA per DB", [Passing EPA per Dropback] ),
    _Season/*__FILTER_ARGUMENTS__*/
)
