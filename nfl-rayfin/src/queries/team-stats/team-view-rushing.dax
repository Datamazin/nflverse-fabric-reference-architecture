DEFINE
    VAR _PSS =
        TREATAS (
            { ( "__SEASON__", "__SEASON_TYPE__" ) },
            'Player Season Summary'[season],
            'Player Season Summary'[season_type]
        )
    VAR _TSS =
        TREATAS (
            { ( "__SEASON__", "__SEASON_TYPE__" ) },
            'Team Season Summary'[season],
            'Team Season Summary'[season_type]
        )
EVALUATE
SUMMARIZECOLUMNS (
    ROLLUPADDISSUBTOTAL (
        ROLLUPGROUP (
            'Team'[team_key],
            'Team'[Team Name],
            'Team'[Team Code],
            'Team'[team_logo_espn],
            'Team'[Team Conference],
            'Team'[Team Division]
        ),
        "IsGrandTotal"
    ),
    _PSS,
    _TSS,
    /*__FILTER_ARGUMENTS__*/"Rush Yds", [Rushing Yards],
    "Yds per G", DIVIDE ( [Rushing Yards], [Games] ),
    "Att", [Rushing Attempts],
    "Yds per Att", DIVIDE ( [Rushing Yards], [Rushing Attempts] ),
    "TD", [Rushing TDs],
    "Explosive Pct", [Explosive Rush Rate],
    "Stuff Pct", [Stuff Rate],
    "EPA per Rush", [Rushing EPA per Play]
)
ORDER BY [IsGrandTotal] DESC, [Rush Yds] DESC, 'Team'[Team Code] ASC
